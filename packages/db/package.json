{
  "name": "@orrn/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./schema/*": {
      "default": "./src/schema/*.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "@orrn/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "libsql": "0.5.22",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orrn/config": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "typescript": "^6"
  }
}
