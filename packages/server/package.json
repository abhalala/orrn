{
  "name": "@orrn/server",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./context": {
      "default": "./src/context.ts"
    },
    "./routers/*": {
      "default": "./src/routers/*.ts"
    },
    "./lib/*": {
      "default": "./src/lib/*.ts"
    },
    "./infra/alchemy.run": {
      "default": "./src/infra/alchemy.run.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "alchemy dev src/infra/alchemy.run.ts",
    "deploy": "alchemy deploy src/infra/alchemy.run.ts",
    "deploy:dev": "bun --env-file=.env run alchemy-deploy-dev",
    "deploy:prod": "bun --env-file=.env run alchemy-deploy-prod",
    "alchemy-deploy-dev": "ALCHEMY_STAGE=dev alchemy deploy src/infra/alchemy.run.ts --stage dev --adopt",
    "alchemy-deploy-prod": "NODE_ENV=production ALCHEMY_STAGE=production alchemy deploy src/infra/alchemy.run.ts --stage production --adopt",
    "destroy": "alchemy destroy src/infra/alchemy.run.ts",
    "bootstrap-super-admin": "bun --env-file=.env src/infra/scripts/bootstrap-super-admin.ts",
    "set-staff-password": "bun --env-file=.env src/infra/scripts/set-staff-password.ts"
  },
  "dependencies": {
    "@orrn/auth": "workspace:*",
    "@orrn/crypto": "workspace:*",
    "@orrn/db": "workspace:*",
    "@orrn/env": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "alchemy": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "zod": "catalog:",
    "@orrn/edge-runtime": "workspace:*"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.0",
    "@orrn/config": "workspace:*",
    "hono": "catalog:",
    "typescript": "^6"
  }
}
