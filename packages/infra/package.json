{
  "name": "@orrn/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "deploy:dev": "bun --env-file=.env run alchemy-deploy-dev",
    "deploy:prod": "bun --env-file=.env run alchemy-deploy-prod",
    "alchemy-deploy-dev": "ALCHEMY_STAGE=dev alchemy deploy --stage dev --adopt",
    "alchemy-deploy-prod": "NODE_ENV=production ALCHEMY_STAGE=production alchemy deploy --stage production --adopt",
    "destroy": "alchemy destroy",
    "bootstrap-super-admin": "bun --env-file=.env scripts/bootstrap-super-admin.ts",
    "set-staff-password": "bun --env-file=.env scripts/set-staff-password.ts"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.0",
    "@orrn/config": "workspace:*",
    "alchemy": "catalog:",
    "typescript": "^6"
  }
}
