{
  "name": "@orrn/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider.tsx",
    "./tokens": "./src/tokens.ts",
    "./charts": "./src/charts/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/button": {
      "react-native": "./src/components/button.native.tsx",
      "default": "./src/components/button.tsx"
