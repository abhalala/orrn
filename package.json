{
  "name": "orrn",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@cloudflare/workers-types": "^4.20251213.0",
      "hono": "^4.8.2",
      "@trpc/server": "^11.16.0",
      "better-auth": "1.6.9",
      "alchemy": "^0.91.2",
      "next-themes": "^0.4.6",
      "@trpc/tanstack-react-query": "^11.16.0",
      "@trpc/client": "^11.16.0",
      "@tanstack/react-query": "^5.90.12",
      "@tanstack/react-form": "^1.28.0",
      "@types/react-dom": "^19.2.3",
      "@better-auth/expo": "1.6.9",
      "@tamagui/config": "^1.136.0",
      "@tamagui/core": "^1.136.0",
      "@tamagui/vite-plugin": "^1.136.0",
      "@tamagui/babel-plugin": "^1.136.0",
      "tamagui": "^1.136.0",
      "react-native-web": "^0.21.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:local": "turbo -F @orrn/server dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @orrn/server dev",
    "db:push": "turbo -F @orrn/db db:push",
    "db:generate": "turbo -F @orrn/db db:generate",
    "deploy": "turbo -F @orrn/server deploy",
    "deploy:dev": "turbo -F @orrn/server deploy:dev",
    "deploy:prod": "turbo -F @orrn/server deploy:prod",
    "destroy": "turbo -F @orrn/server destroy"
  },
  "dependencies": {
    "@orrn/env": "workspace:*",
    "@tamagui/config": "catalog:",
    "dotenv": "catalog:",
    "tamagui": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@orrn/config": "workspace:*",
    "@tamagui/core": "catalog:",
    "@tamagui/vite-plugin": "catalog:",
    "@types/node": "^22.13.14",
    "turbo": "^2.8.12",
    "typescript": "^6"
  },
  "packageManager": "bun@1.3.13"
}
