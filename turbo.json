{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "ALCHEMY_PASSWORD",
    "ALCHEMY_STATE_TOKEN",
    "ALCHEMY_STATE_FORCE_UPDATE",
    "BETTER_AUTH_SECRET",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ZONE_ID",
    "CLOUDFLARE_ZONE_ID_APP",
    "CLOUDFLARE_ZONE_ID_IN",
    "ALCHEMY_STAGE",
    "CORS_ALLOWED_ORIGINS",
    "WEB_PUBLIC_URL",
    "ORRN_MASTER_KEY",
    "RESEND_API_KEY",
    "WEBHOOK_BASE_URL",
    "WEB_DOMAIN",
    "API_DOMAIN",
    "VITE_SERVER_URL",
    "VITE_PUBLIC_URL",
    "BETTER_AUTH_URL",
    "CORS_ORIGIN",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^check-types"]
    },
    "test:visual": {
      "dependsOn": ["^check-types"],
      "cache": false
    },
    "test:visual:update": {
      "dependsOn": ["^check-types"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "deploy": {
      "cache": false
    },
    "deploy:dev": {
      "cache": false
    },
    "deploy:prod": {
      "cache": false
    },
    "destroy": {
      "cache": false
    }
  }
}
