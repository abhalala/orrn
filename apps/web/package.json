{
  "name": "web",
  "description": "Unified web app: marketing, ERP, and platform admin (orrn.in)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && bun scripts/check-modulepreload.ts && bun scripts/check-route-budget.ts",
    "serve": "vite preview",
    "start": "vite",
    "check-types": "vite build && tsc --noEmit",
    "dev:bare": "vite dev",
    "test": "bun test src scripts",
    "test:e2e": "playwright test --project=e2e",
    "e2e:group": "bash scripts/e2e-group.sh",
    "test:visual": "playwright test --project=desktop-dark --project=mobile-dark --project=desktop-light --project=mobile-light",
    "test:visual:update": "playwright test --project=desktop-dark --project=mobile-dark --project=desktop-light --project=mobile-light --update-snapshots"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@orrn/documents": "workspace:*",
    "@orrn/domain": "workspace:*",
    "@orrn/env": "workspace:*",
    "@orrn/i18n": "workspace:*",
    "@orrn/server": "workspace:*",
    "@orrn/ui": "workspace:*",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "^1.168.22",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "@types/qrcode": "^1.5.6",
    "barcode-detector": "^3.2.2",
    "better-auth": "catalog:",
    "date-fns": "^4.2.1",
    "jsbarcode": "^3.12.1",
    "lucide-react": "^1.8.0",
    "next-themes": "catalog:",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "xlsx": "^0.18.5",
    "zod": "catalog:",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@orrn/config": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/router-plugin": "^1.167.22",
    "@types/node": "^22.13.14",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.1",
    "alchemy": "catalog:",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^6",
    "vite": "^8.0.8"
  }
}
