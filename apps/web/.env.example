# Copy to apps/web/.env.development.local (gitignored) for the local stack.
# API worker started by: bun run --cwd apps/server dev:local
VITE_SERVER_URL=http://localhost:3000
# Public origin of this web app (local web runs on 3002; 3001 is often taken).
# In a git worktree use the ports from .wt-ports.env (E2E_API_PORT / E2E_WEB_PORT) instead.
VITE_PUBLIC_URL=http://localhost:3002
