# Copy to apps/native/.env (gitignored).
# Simulator/emulator can use localhost; a physical device needs your machine's LAN IP,
# e.g. http://192.168.1.20:3000 (and the server must be reachable on that address).
EXPO_PUBLIC_SERVER_URL=http://localhost:3000
# Where "Open on the web" and "Forgot password" send people (the web app). Falls back to EXPO_PUBLIC_SERVER_URL.
# EXPO_PUBLIC_WEB_URL=http://localhost:3001
