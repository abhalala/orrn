{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev:local": "bun scripts/dev-local.ts",
    "dev:local:migrate": "wrangler d1 migrations apply orrn-local --local -c wrangler.local.jsonc",
    "test": "bun test src"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.0",
    "@orrn/server": "workspace:*",
    "@orrn/auth": "workspace:*",
    "@orrn/crypto": "workspace:*",
    "@orrn/db": "workspace:*",
    "@orrn/domain": "workspace:*",
    "@orrn/edge-runtime": "workspace:*",
    "@orrn/env": "workspace:*",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.1",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orrn/config": "workspace:*",
    "@types/bun": "^1.3.13",
    "@types/node": "^22.13.14",
    "alchemy": "catalog:",
    "tsdown": "^0.21.9",
    "typescript": "^6",
    "wrangler": "4"
  }
}
